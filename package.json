{
  "name": "cross-math",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.19.1"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -b && node scripts/build-web.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:core": "cargo test -p cross-math-core",
    "test:wasm": "node scripts/verify-wasm.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "check": "npm run typecheck && npm test && cargo test -p cross-math-core && cargo clippy -p cross-math-core -- -D warnings",
    "check:actions": "node scripts/check-actions.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "2.12.4",
    "dexie": "4.4.6",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
